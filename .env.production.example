# Public routing
PRODUCTION_DOMAIN=api.bookmate.kr
TRAEFIK_CERT_RESOLVER=myresolver
API_BIND_ADDRESS=127.0.0.1
API_PORT=18081

# Supabase session pooler. Copy the values from Supabase's Connect > JDBC page.
# Keep the real password only in .env.production / GitHub's production secret.
DB_URL=jdbc:postgresql://aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.your_supabase_project_ref
DB_PASSWORD=change-this-to-your-supabase-database-password
DB_POOL_MIN_IDLE=0
DB_POOL_MAX_SIZE=3
DB_POOL_IDLE_TIMEOUT_MS=60000
DB_POOL_KEEPALIVE_MS=0

PUBLIC_BASE_URL=https://api.bookmate.kr
APPLE_CLIENT_ID=cozyrim.BookMate-mini
DISCORD_LOGIN_WEBHOOK_URL=

# Use the same signing secret as the current production API so existing login
# tokens remain valid after the cutover.
JWT_SECRET=change-this-to-the-current-production-jwt-secret
JWT_EXPIRATION_SECONDS=1209600
JWT_REFRESH_EXPIRATION_SECONDS=2592000
MODERATION_ADMIN_SECRET=change-this-to-the-current-production-admin-secret
SWAGGER_ENABLED=false

FCM_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
# Set these only when FCM_ENABLED=true and using the existing JSON key file.
# The host file is mounted read-only at the path below inside the container.
USE_FIREBASE_SECRET_FILE=false
FIREBASE_SERVICE_ACCOUNT_HOST_PATH=
# FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json

# Leave false to keep new images on the Mini PC's persistent Docker volume.
# If production already uses Cloudflare R2, copy its existing values instead.
R2_ENABLED=false
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
