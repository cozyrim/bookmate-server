TRAEFIK_CERT_RESOLVER=myresolver

# API_IMAGE=ghcr.io/cozyrim/bookmate-server:staging
API_BIND_ADDRESS=127.0.0.1
API_PORT=18080

POSTGRES_DB=bookmate_staging
POSTGRES_USER=bookmate
